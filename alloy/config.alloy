discovery.docker "all_containers" {
  host = "unix:///var/run/docker.sock"
  refresh_interval = "10s"
}

discovery.relabel "docker_labels" {
  targets = discovery.docker.all_containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "job"
  }
}

loki.source.docker "all_containers" {
  host    = "unix:///var/run/docker.sock"
  targets = discovery.relabel.docker_labels.output  // Изменено с .targets на .output
  forward_to = [loki.process.add_labels.receiver]
}

loki.process "add_labels" {

  stage.regex {
    expression = "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3}) \\[(?P<thread>[^\\]]+)\\] (?P<level>\\w+) (?:\\[(?P<trace_id>[^,]+),(?P<span_id>[^\\]]+)\\] )?(?P<logger>\\S+) - (?P<message>.*)"
  }

  stage.labels {
    values = {
      cluster = "spring-market",
      level   = "",
    }
  }

  forward_to = [loki.write.loki_endpoint.receiver]
}

loki.write "loki_endpoint" {
  endpoint {
    url        = "http://grafana-loki:3100/loki/api/v1/push"
    batch_size = "10KB"
    batch_wait = "5s"
  }
}

logging {
  level  = "debug"
  format = "logfmt"
}